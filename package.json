{
  "name": "habun-mitarbeiterportal-main-repair",
  "private": true,
  "version": "2026.8.6",
  "type": "module",
  "scripts": {
    "verify:legacy": "node scripts/admin-time-test.mjs && node scripts/schedule-multi-test.mjs",
    "verify:v2": "node scripts/attendance-v2-verify.mjs",
    "verify:unified": "node scripts/unified-portal-test.mjs && node scripts/attendance-pause-test.mjs && node scripts/company-settings-test.mjs && node scripts/pdf-branding-test.mjs",
    "verify:all": "npm run verify:legacy && npm run verify:v2 && npm run verify:unified",
    "verify": "npm run verify:all",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build": "npm run verify && npm run build:frontend && node scripts/build.mjs",
    "check": "npm run verify",
    "test:e2e": "node scripts/prepare-unified-e2e.mjs && playwright test tests/e2e/unified-portal.spec.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@netlify/blobs": "^10.7.11",
    "@netlify/identity": "^1.2.0",
    "esbuild": "^0.25.5",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "http-server": "^14.1.1"
  }
}
